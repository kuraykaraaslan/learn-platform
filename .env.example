# learn.kuray.dev — local environment. NEVER commit a real .env.
# This project has no database/auth (see docs/adr/0001-no-backend-markdown-content.md),
# so there is currently nothing required to run it locally beyond `npm install`.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebContainer (P9) — required only for the Run Project feature on the ~62
# lessons that need a real npm install + server, not for the site generally.
# Get one from https://webcontainers.io — see docs/adr/0002 for the licensing
# note before using this in anything beyond local development.
NEXT_PUBLIC_WEBCONTAINER_API_KEY=
